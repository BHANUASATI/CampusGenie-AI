# Database Configuration
DATABASE_URL=mysql+mysqlconnector://root:@localhost:3306/CampusGenie

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:3002", "http://localhost:3003", "http://localhost:3004", "http://localhost:3005", "http://localhost:3006"]

# ── Spoken answers (text-to-speech) ──────────────────────────────────────
# The browser's built-in speech API cannot make a voice sound conversational, so
# spoken answers are synthesised by a neural model on the backend instead.
# Requires `edge-tts` from requirements.txt. If synthesis is unavailable the app
# quietly falls back to the browser voice, so nothing here is mandatory.
#
# Provider: edge (no key, Microsoft's neural voices) | openai | google
TTS_PROVIDER=edge
# Slightly under natural pace. Neural voices at exactly 0% can sound clipped;
# -4% reads as unhurried rather than slow.
TTS_RATE=-4%

# Provider: openai
# Needs a real OPENAI_API_KEY (the template value above will not work). This is
# the closest match to a conversational assistant voice, because it accepts a
# natural-language instruction on how to speak.
# TTS_PROVIDER=openai
# TTS_OPENAI_MODEL=gpt-4o-mini-tts
# TTS_OPENAI_VOICE=marin
# TTS_INSTRUCTIONS=Speak in a warm, natural, conversational tone, like a helpful person explaining something rather than reading a document.

# Provider: google
# Google Cloud Text-to-Speech requires OAuth2, not an API key, so the Gemini key
# cannot be used here. Supply a service-account access token to enable it.
# TTS_PROVIDER=google
# GOOGLE_TTS_ACCESS_TOKEN=

# ── Institutions ─────────────────────────────────────────────────────────
# Accounts must belong to one of these email domains. The login and signup
# screens read the list from GET /api/institutions, so the picker and the API
# validation can never disagree.
#
# Single institution (default): set only the singular value.
UNIVERSITY_EMAIL_DOMAIN=university.edu.in

# Several institutions on one deployment: list them here, comma separated.
# UNIVERSITY_EMAIL_DOMAIN above is always accepted as well, so you can add
# institutions without displacing existing accounts.
# UNIVERSITY_EMAIL_DOMAINS=krmu.ac.in,northbridge.edu.in

# Display names shown in the institution picker, as "domain=Name" pairs. Any
# domain without an entry falls back to a title-cased guess from the domain,
# which is usually wrong for a real university — so set these for anything a
# user will see.
# INSTITUTION_NAMES=krmu.ac.in=K.R. Mangalam University,northbridge.edu.in=Northbridge Institute of Technology

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your-openai-api-key

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=your-gemini-api-key

# The free tier caps each model at a fixed number of requests/day, and an
# exhausted model returns 429 in ~0.5s. Keep models that still answer FIRST and
# commonly-exhausted ones LAST, or every message pays for a dead model.
# Check which are reachable for your key (prints a paste-ready block):
#   cd backend && python3 scripts/check_gemini_models.py --full
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=["gemini-2.5-flash", "gemini-3.1-flash-lite", "gemini-3.5-flash", "gemini-flash-latest"]
# Healthy latency for this app's ~6k-token RAG prompt is 2-5s, so 25s is a
# generous hard cap. Lower it if you would rather rotate to a fallback sooner.
GEMINI_TIMEOUT_SECONDS=25

# LangSmith Tracing (Optional — https://smith.langchain.com)
# Create an API key under Settings -> API Keys, then set
# ENABLE_LANGSMITH_TRACING=true. Graph, retrieval and LLM runs (with token
# counts and cost) are posted to LANGSMITH_PROJECT as you use the app.
# Requires the `langsmith` package from requirements.txt.
ENABLE_LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=CampusGenie

# Microsoft Azure AD Configuration (Required for OAuth)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=38fd5a4b-955f-455a-9ad2-d2daa5a4e4d0
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback